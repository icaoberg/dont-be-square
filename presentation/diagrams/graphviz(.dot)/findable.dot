// Findable pillar - trunk diagram (alternating left/right)
// Run: dot -Tpng findable.dot -o findable.png

digraph Findable {
  rankdir=TB;
  graph [ranksep=0.15, nodesep=0.30, splines=false];
  node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", color=black, fillcolor=white];
  edge [fontname="Arial", fontsize=9, color=black, dir=none];

  // Top
    findable [
      label="Findable",
      fillcolor=lightblue,
      penwidth=2,
      fontsize=18,
      width=2.2,
      height=0.9
    ];
  // Trunk (one spine point per metric level)
  s1 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s2 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s3 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s4 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s5 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s6 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s7 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];
  s8 [label="", shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black, color=black, group=mid];

  findable -> s1 [penwidth=2.2];
  s1 -> s2 [penwidth=2.2];
  s2 -> s3 [penwidth=2.2];
  s3 -> s4 [penwidth=2.2];
  s4 -> s5 [penwidth=2.2];
  s5 -> s6 [penwidth=2.2];
  s6 -> s7 [penwidth=2.2];
  s7 -> s8 [penwidth=2.2];

  // Metrics (alternating left/right down the trunk)
  m1 [label="metadata Exist", group=left, penwidth=1.3];
  m2 [label="Uuid", group=right, penwidth=1.3];
  m3 [label="Antibodies", group=left, penwidth=1.3];
  m4 [label="Dataset Entity", group=right, penwidth=1.3];
  m5 [label="Title", group=left, penwidth=1.3];
  m6 [label="Published", group=right, penwidth=1.3];
  m7 [label="Contributors", group=left, penwidth=1.3];
  m8 [label="Contactcs", group=right, penwidth=1.3];

  // Invisible placeholders to keep trunk centered (one per row, opposite side)
  p1 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=right];
  p2 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=left];
  p3 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=right];
  p4 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=left];
  p5 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=right];
  p6 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=left];
  p7 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=right];
  p8 [label="", shape=box, style=invis, width=1.8, height=0.35, fixedsize=true, group=left];

  // Row 1 (LEFT): metadata exist
  m1 -> s1 [penwidth=1.5, style=dashed];
  { rank=same; m1; s1; p1; }
  m1 -> s1 -> p1 [style=invis, weight=50];

  // Row 2 (RIGHT): uuid
  m2 -> s2 [penwidth=1.5, style=dashed];
  { rank=same; p2; s2; m2; }
  p2 -> s2 -> m2 [style=invis, weight=100];

  // Row 3 (LEFT): antibodies
  m3 -> s3 [penwidth=1.5, style=dashed];
  { rank=same; m3; s3; p3; }
  m3 -> s3 -> p3 [style=invis, weight=100];

  // Row 4 (RIGHT): dataset entity
  m4 -> s4 [penwidth=1.5, style=dashed];
  { rank=same; p4; s4; m4; }
  p4 -> s4 -> m4 [style=invis, weight=100];

  // Row 5 (LEFT): title
  m5 -> s5 [penwidth=1.5, style=dashed];
  { rank=same; m5; s5; p5; }
  m5 -> s5 -> p5 [style=invis, weight=100];

  // Row 6 (RIGHT): published
  m6 -> s6 [penwidth=1.5, style=dashed];
  { rank=same; p6; s6; m6; }
  p6 -> s6 -> m6 [style=invis, weight=100];

  // Row 7 (LEFT): contributors
  m7 -> s7 [penwidth=1.5, style=dashed];
  { rank=same; m7; s7; p7; }
  m7 -> s7 -> p7 [style=invis, weight=100];

  // Row 8 (RIGHT): contactcs
  m8 -> s8 [penwidth=1.5, style=dashed];
  { rank=same; p8; s8; m8; }
  p8 -> s8 -> m8 [style=invis, weight=100];
}

