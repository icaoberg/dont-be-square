// Accessible pillar - trunk diagram (alternating left/right)
// Run: dot -Tpng accessible.dot -o accessible.png

digraph Accessible {
  rankdir=TB;
  graph [ranksep=0.15, nodesep=0.30, splines=false];
  node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", color=black, fillcolor=white];
  edge [fontname="Arial", fontsize=9, color=black, dir=none];

  // Top
  accessible [
    label="Accessible",
    fillcolor=lightblue,
    penwidth=2,
    fontsize=18,
    width=2.2,
    height=0.9
  ];

  // Trunk
  s1 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s2 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s3 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s4 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s5 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s6 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s7 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s8 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];
  s9 [shape=point, width=0.06, height=0.06, fixedsize=true, style=filled, fillcolor=black];

  accessible -> s1 [penwidth=2.2];
  s1 -> s2 [penwidth=2.2];
  s2 -> s3 [penwidth=2.2];
  s3 -> s4 [penwidth=2.2];
  s4 -> s5 [penwidth=2.2];
  s5 -> s6 [penwidth=2.2];
  s6 -> s7 [penwidth=2.2];
  s7 -> s8 [penwidth=2.2];
  s8 -> s9 [penwidth=2.2];

  // Metrics
  m1 [label="doi exist", group=left];
  m2 [label="doi works", group=right];
  m3 [label="group_name", group=left];
  m4 [label="group_uuid", group=right];
  m5 [label="hubmap_id", group=left];
  m6 [label="register_doi", group=right];
  m7 [label="registered_doi (validar)", group=left];
  m8 [label="protocols_io_doi (validar)", group=right];
  m9 [label="reagent_prep_protocols_io_doi (validar)", group=left];

  // Invisible placeholders
  p1 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=right];
  p2 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=left];
  p3 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=right];
  p4 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=left];
  p5 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=right];
  p6 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=left];
  p7 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=right];
  p8 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=left];
  p9 [shape=box, style=invis, width=2.4, height=0.35, fixedsize=true, group=right];

  // Alternating rows (branches dashed)
  m1 -> s1 [style=dashed]; { rank=same; m1; s1; p1; } m1 -> s1 -> p1 [style=invis, weight=100];
  m2 -> s2 [style=dashed]; { rank=same; p2; s2; m2; } p2 -> s2 -> m2 [style=invis, weight=100];
  m3 -> s3 [style=dashed]; { rank=same; m3; s3; p3; } m3 -> s3 -> p3 [style=invis, weight=100];
  m4 -> s4 [style=dashed]; { rank=same; p4; s4; m4; } p4 -> s4 -> m4 [style=invis, weight=100];
  m5 -> s5 [style=dashed]; { rank=same; m5; s5; p5; } m5 -> s5 -> p5 [style=invis, weight=100];
  m6 -> s6 [style=dashed]; { rank=same; p6; s6; m6; } p6 -> s6 -> m6 [style=invis, weight=100];
  m7 -> s7 [style=dashed]; { rank=same; m7; s7; p7; } m7 -> s7 -> p7 [style=invis, weight=100];
  m8 -> s8 [style=dashed]; { rank=same; p8; s8; m8; } p8 -> s8 -> m8 [style=invis, weight=100];
  m9 -> s9 [style=dashed]; { rank=same; m9; s9; p9; } m9 -> s9 -> p9 [style=invis, weight=100];
}